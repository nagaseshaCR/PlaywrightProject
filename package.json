{
  "name": "playwrightauto",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test --reporter=line,allure-playwright --config playwright.config1.js --project=chrome",
    "allure:generate": "allure generate ./allure-results --clear",
    "allure:open": "allure open allure-reports",
    "test:allure": "npm run test && npm run allure:generate && npm run allure:open",
    "RegressionTest": "npx playwright test --headed",
    "RegressionTestWeb": "npx playwright test --grep '@Web' --headed",
    "RegressionTestApi": "npx playwright test --grep '@API' --headed",
    "SafariTest": "npx playwright test --config playwright.config1.js --project=safari",
    "SafariTestWeb": "npx playwright test --grep @web --config playwright.config1.js --project=safari"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.2.1",
    "allure-playwright": "^3.9.0"
  },
  "dependencies": {
    "exceljs": "^3.4.0",
    "playwright": "^1.60.0"
  }
}
